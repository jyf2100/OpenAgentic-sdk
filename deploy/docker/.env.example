# Worker 环境变量配置示例
# 复制为 .env 并填入实际值

# ============ Host 配置 ============
HOST_PORT=8766

# ============ Worker 配置 ============
WORKER_NAME=worker-0
WORKER_PORT=19000

# 代码仓库路径 (相对于项目根目录)
CODE_PATH=../..

# ============ LLM Provider ============
# 选择一个 Provider 填入

# Option 1: Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Option 2: OpenAI
# OPENAI_API_KEY=sk-xxxxx

# Option 3: RightCode
# RIGHTCODE_API_KEY=sk-xxxxx
# RIGHTCODE_BASE_URL=https://api.rightcode.com

# ============ OpenTelemetry (可选) ============
# OTEL_ENDPOINT=http://otel-collector:4318

# ============ 多 Worker 实例 ============
# 创建多个 .env 文件，例如:
# .env.worker-0: WORKER_NAME=worker-0 WORKER_PORT=19000
# .env.worker-1: WORKER_NAME=worker-1 WORKER_PORT=19001
