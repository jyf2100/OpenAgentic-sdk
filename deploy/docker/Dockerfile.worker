# Dockerfile.worker - OpenAgentic SDK Worker 镜像
# 构建命令: docker build -f deploy/docker/Dockerfile.worker -t oa-worker .
FROM python:3.12-slim

WORKDIR /workspace

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 复制并安装 SDK
COPY pyproject.toml ./pyproject.toml
COPY openagentic_sdk ./openagentic_sdk
RUN pip install --no-cache-dir -e .

# 健康检查脚本
RUN echo '#!/bin/bash\n\
curl -sf http://localhost:8765/health > /dev/null || exit 1' > /usr/local/bin/healthcheck && \
    chmod +x /usr/local/bin/healthcheck

EXPOSE 8765

# 默认参数
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD /usr/local/bin/healthcheck

ENTRYPOINT ["python", "-u", "-m", "openagentic_sdk.subagents.remote_http_worker_server"]
CMD ["--host", "0.0.0.0", "--port", "8765"]
